{
  "name": "@mizcausevic-dev/mcp-aeo-server",
  "version": "0.1.0",
  "description": "Stdio MCP server for fetching and inspecting AEO Protocol declarations from canonical HTTPS endpoints.",
  "type": "module",
  "bin": {
    "mcp-aeo-server": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    "tool-cards",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "tool-cards:export": "node dist/export-tool-cards.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aeo",
    "agent",
    "claude",
    "well-known"
  ],
  "author": "Miz Causevic",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/mcp-aeo-server.git"
  },
  "homepage": "https://github.com/mizcausevic-dev/mcp-aeo-server",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
